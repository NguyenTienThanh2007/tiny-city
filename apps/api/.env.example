# Backend only. Do not use a VITE_ prefix. Copying/loading never overrides shell variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_RETRIES=1
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_MAX_CONTEXT_CHARS=32000
TINY_CITY_PROVIDER_MODE=gemini
TINY_CITY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TINY_CITY_PLANNER_TIMEOUT_SECONDS=15
TINY_CITY_MAX_INFLIGHT=2
TINY_CITY_REQUESTS_PER_MINUTE=12
TINY_CITY_BODY_LIMIT_BYTES=1048576
TINY_CITY_NODE_BINARY=node

# Accounts and cloud cities. Apply `uv run alembic upgrade head` before starting the API.
# SQLite is for a single local development instance; production should use shared PostgreSQL.
APP_ENV=development
DATABASE_URL=sqlite:///./tiny_city.db
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=2592000
VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
MAX_USER_CITY_SAVES=30
MAX_CLOUD_SAVE_BYTES=1048576

# Email is disabled by default. For local-only testing, explicitly opt into the dev mailbox:
# AUTH_EMAIL_BACKEND=dev_sink
# DEV_EMAIL_SINK_ENABLED=true
AUTH_EMAIL_BACKEND=disabled
DEV_EMAIL_SINK_ENABLED=false
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_EMAIL_LIMIT=4
AUTH_TOKEN_LIMIT=20
