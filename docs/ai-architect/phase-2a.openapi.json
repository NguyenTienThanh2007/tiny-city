{
  "openapi": "3.1.0",
  "info": {
    "title": "TINY CITY API",
    "description": "Phase 2A AI city interpretation and authoritative TypeScript planning. The client owns the live simulation.",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/city/plan": {
      "post": {
        "tags": [
          "AI city architect"
        ],
        "summary": "Plan",
        "operationId": "plan_v1_city_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanningRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanningResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/city/plan/validate": {
      "post": {
        "tags": [
          "AI city architect"
        ],
        "summary": "Validate",
        "operationId": "validate_v1_city_plan_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanningResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/city/catalog": {
      "get": {
        "tags": [
          "AI city architect"
        ],
        "summary": "Catalog",
        "operationId": "catalog_v1_city_catalog_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArchitectIntent": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Summary"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "vi"
            ],
            "title": "Language"
          },
          "style": {
            "type": "string",
            "enum": [
              "compact",
              "coastal",
              "mixed"
            ],
            "title": "Style",
            "default": "compact"
          },
          "near": {
            "type": "string",
            "enum": [
              "existing",
              "park",
              "road",
              "center"
            ],
            "title": "Near",
            "default": "existing"
          },
          "region": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Region"
              },
              {
                "type": "null"
              }
            ]
          },
          "budgetLimit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9007199254740991.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budgetlimit"
          },
          "connectRoads": {
            "type": "boolean",
            "title": "Connectroads",
            "default": true
          },
          "builds": {
            "items": {
              "$ref": "#/components/schemas/BuildRequest"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Builds"
          },
          "moves": {
            "items": {
              "$ref": "#/components/schemas/MoveRequest"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Moves"
          },
          "demolish": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 128,
            "title": "Demolish"
          },
          "roadAdd": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "maxItems": 128,
            "title": "Roadadd"
          },
          "roadRemove": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "maxItems": 128,
            "title": "Roadremove"
          },
          "preserveBuildingIds": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 128,
            "title": "Preservebuildingids"
          },
          "unsupportedRequests": {
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "type": "array",
            "maxItems": 32,
            "title": "Unsupportedrequests"
          },
          "ambiguities": {
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "type": "array",
            "maxItems": 32,
            "title": "Ambiguities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary",
          "language"
        ],
        "title": "ArchitectIntent"
      },
      "BuildCommand": {
        "properties": {
          "type": {
            "type": "string",
            "const": "city.build",
            "title": "Type"
          },
          "buildingType": {
            "type": "string",
            "enum": [
              "villa",
              "duplex",
              "townhouse",
              "apartment",
              "park",
              "clubhouse",
              "pool",
              "mall",
              "office"
            ],
            "title": "Buildingtype"
          },
          "position": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "buildingType",
          "position"
        ],
        "title": "BuildCommand"
      },
      "BuildRequest": {
        "properties": {
          "buildingType": {
            "type": "string",
            "enum": [
              "villa",
              "duplex",
              "townhouse",
              "apartment",
              "park",
              "clubhouse",
              "pool",
              "mall",
              "office"
            ],
            "title": "Buildingtype"
          },
          "quantity": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Quantity"
          },
          "preferredPosition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "buildingType",
          "quantity"
        ],
        "title": "BuildRequest"
      },
      "DemolishCommand": {
        "properties": {
          "type": {
            "type": "string",
            "const": "city.demolish",
            "title": "Type"
          },
          "buildingId": {
            "type": "string",
            "title": "Buildingid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "buildingId"
        ],
        "title": "DemolishCommand"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Footprint": {
        "properties": {
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "width",
          "height"
        ],
        "title": "Footprint"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "const": "tiny-city-api",
            "title": "Service",
            "default": "tiny-city-api"
          },
          "phase": {
            "type": "integer",
            "const": 0,
            "title": "Phase",
            "default": 0
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "MoveCommand": {
        "properties": {
          "type": {
            "type": "string",
            "const": "city.move-building",
            "title": "Type"
          },
          "buildingId": {
            "type": "string",
            "title": "Buildingid"
          },
          "position": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "buildingId",
          "position"
        ],
        "title": "MoveCommand"
      },
      "MoveRequest": {
        "properties": {
          "buildingId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Buildingid"
          },
          "position": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "buildingId",
          "position"
        ],
        "title": "MoveRequest"
      },
      "Placement": {
        "properties": {
          "buildingId": {
            "type": "string",
            "title": "Buildingid"
          },
          "buildingType": {
            "type": "string",
            "enum": [
              "villa",
              "duplex",
              "townhouse",
              "apartment",
              "park",
              "clubhouse",
              "pool",
              "mall",
              "office"
            ],
            "title": "Buildingtype"
          },
          "position": {
            "$ref": "#/components/schemas/Point"
          },
          "footprint": {
            "$ref": "#/components/schemas/Footprint"
          },
          "operation": {
            "type": "string",
            "enum": [
              "build",
              "move"
            ],
            "title": "Operation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "buildingId",
          "buildingType",
          "position",
          "footprint",
          "operation"
        ],
        "title": "Placement"
      },
      "PlanProposal": {
        "properties": {
          "contractVersion": {
            "type": "integer",
            "const": 1,
            "title": "Contractversion"
          },
          "planId": {
            "type": "string",
            "title": "Planid"
          },
          "digest": {
            "type": "string",
            "title": "Digest"
          },
          "sourceWorldId": {
            "type": "string",
            "title": "Sourceworldid"
          },
          "sourceRevision": {
            "type": "integer",
            "title": "Sourcerevision"
          },
          "sourceFingerprint": {
            "type": "string",
            "title": "Sourcefingerprint"
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "status": {
            "type": "string",
            "enum": [
              "VALIDATED",
              "REJECTED"
            ],
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "intent": {
            "$ref": "#/components/schemas/ArchitectIntent"
          },
          "constraints": {
            "$ref": "#/components/schemas/PlanningConstraints"
          },
          "placements": {
            "items": {
              "$ref": "#/components/schemas/Placement"
            },
            "type": "array",
            "title": "Placements"
          },
          "roads": {
            "$ref": "#/components/schemas/Roads"
          },
          "projectedPlan": {
            "additionalProperties": true,
            "type": "object",
            "title": "Projectedplan"
          },
          "estimatedCost": {
            "type": "integer",
            "title": "Estimatedcost"
          },
          "projectedBudget": {
            "type": "integer",
            "title": "Projectedbudget"
          },
          "validation": {
            "$ref": "#/components/schemas/PlanValidation"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "type": "array",
            "title": "Warnings"
          },
          "commands": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/BuildCommand"
                },
                {
                  "$ref": "#/components/schemas/MoveCommand"
                },
                {
                  "$ref": "#/components/schemas/DemolishCommand"
                },
                {
                  "$ref": "#/components/schemas/RoadCommand"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "city.build": "#/components/schemas/BuildCommand",
                  "city.demolish": "#/components/schemas/DemolishCommand",
                  "city.edit-roads": "#/components/schemas/RoadCommand",
                  "city.move-building": "#/components/schemas/MoveCommand"
                }
              }
            },
            "type": "array",
            "title": "Commands"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contractVersion",
          "planId",
          "digest",
          "sourceWorldId",
          "sourceRevision",
          "sourceFingerprint",
          "seed",
          "status",
          "summary",
          "explanation",
          "intent",
          "constraints",
          "placements",
          "roads",
          "projectedPlan",
          "estimatedCost",
          "projectedBudget",
          "validation",
          "warnings",
          "commands"
        ],
        "title": "PlanProposal"
      },
      "PlanValidation": {
        "properties": {
          "valid": {
            "type": "boolean",
            "title": "Valid"
          },
          "fulfilled": {
            "type": "boolean",
            "title": "Fulfilled"
          },
          "operationCount": {
            "type": "integer",
            "title": "Operationcount"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "valid",
          "fulfilled",
          "operationCount"
        ],
        "title": "PlanValidation"
      },
      "PlanningConstraints": {
        "properties": {
          "allowPartial": {
            "type": "boolean",
            "title": "Allowpartial",
            "default": false
          },
          "allowDestructive": {
            "type": "boolean",
            "title": "Allowdestructive",
            "default": false
          },
          "allowedDemolitions": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 128,
            "title": "Alloweddemolitions"
          },
          "allowedRoadRemovals": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "maxItems": 128,
            "title": "Allowedroadremovals"
          },
          "preserveBuildingIds": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 128,
            "title": "Preservebuildingids"
          },
          "budgetLimit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9007199254740991.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budgetlimit"
          },
          "maxOperations": {
            "type": "integer",
            "maximum": 128.0,
            "minimum": 1.0,
            "title": "Maxoperations",
            "default": 128
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PlanningConstraints"
      },
      "PlanningRequest": {
        "properties": {
          "contractVersion": {
            "type": "integer",
            "const": 1,
            "title": "Contractversion"
          },
          "prompt": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Prompt"
          },
          "world": {
            "additionalProperties": true,
            "type": "object",
            "title": "World"
          },
          "sourceRevision": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Sourcerevision"
          },
          "seed": {
            "type": "integer",
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 0
          },
          "constraints": {
            "$ref": "#/components/schemas/PlanningConstraints"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contractVersion",
          "prompt",
          "world",
          "sourceRevision"
        ],
        "title": "PlanningRequest"
      },
      "PlanningResponse": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "proposal": {
            "$ref": "#/components/schemas/PlanProposal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "proposal"
        ],
        "title": "PlanningResponse"
      },
      "Point": {
        "properties": {
          "x": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": -9007199254740991.0,
            "title": "X"
          },
          "y": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": -9007199254740991.0,
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Point"
      },
      "Region": {
        "properties": {
          "x": {
            "type": "integer",
