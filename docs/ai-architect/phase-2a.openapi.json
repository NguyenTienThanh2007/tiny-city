            "minimum": -9007199254740991.0,
            "title": "X"
          },
          "y": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": -9007199254740991.0,
            "title": "Y"
          },
          "width": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Height"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "Region"
      },
