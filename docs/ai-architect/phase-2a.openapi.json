        "properties": {
          "type": {
            "type": "string",
            "const": "city.edit-roads",
            "title": "Type"
          },
          "add": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "title": "Add"
          },
          "remove": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "title": "Remove"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "add",
          "remove"
        ],
        "title": "RoadCommand"
      },
      "Roads": {
        "properties": {
          "add": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "title": "Add"
          },
          "remove": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "title": "Remove"
          }
        },
        "additionalProperties": false,
        "type": "object",
