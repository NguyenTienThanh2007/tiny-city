{
  "name": "tiny-city-imagine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/simulation"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:simulation": "npm run build --workspace @tiny-city/simulation",
    "predev": "npm run build:simulation",
    "dev": "vite",
    "prebuild": "npm run build:simulation",
    "build": "tsc -b && vite build",
    "typecheck": "npm run typecheck --workspace @tiny-city/simulation && npm run build:simulation && tsc -b --pretty false && tsc -p tsconfig.e2e.json",
    "pretest": "npm run build:simulation",
    "test": "vitest run",
    "test:simulation": "npm test --workspace @tiny-city/simulation",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tiny-city/simulation": "*",
    "pixi.js": "^8.20.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
