{
  "name": "tiny-city-imagine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/simulation",
    "packages/ai-architect"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:simulation": "npm run build --workspace @tiny-city/simulation",
    "predev": "npm run build:architect",
    "dev": "vite",
    "prebuild": "npm run build:architect",
    "build": "tsc -b && vite build",
    "typecheck": "npm run typecheck --workspace @tiny-city/simulation && npm run build:architect && npm run typecheck --workspace @tiny-city/ai-architect && tsc -b --pretty false && tsc -p tsconfig.e2e.json",
    "pretest": "npm run build:architect",
    "test": "vitest run",
    "test:simulation": "npm test --workspace @tiny-city/simulation",
    "bench:npc": "npm run build:simulation && node scripts/npc_benchmark.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "build:architect": "npm run build:simulation && npm run build --workspace @tiny-city/ai-architect",
    "test:architect": "npm run build:architect && npm test --workspace @tiny-city/ai-architect",
    "security": "python3 scripts/check_secrets.py"
  },
  "dependencies": {
    "@tiny-city/ai-architect": "*",
    "@tiny-city/simulation": "*",
    "pixi.js": "^8.20.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
